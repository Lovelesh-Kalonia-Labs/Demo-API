{
  "exchangeAssetId": "demo-api-raml-spec-test",
  "deployment": {
    "replicas": 1,
    "vCores": 0.1,
    "target": "cloudhub-us-east-2",
    "publicUrl": "demo-api"
  },
  "policies": [
    {
      "name": "client-id-enforcement"
    }
  ],
  "sla": {
    "name": "Default SLA",
    "description": "Default SLA created by CI/CD pipeline to prevent automatic approval of client applications.",
    "autoApprove": false,
    "limits": [
      {
        "visible": true,
        "maximumRequests": 1000,
        "timeUnit": "sec"
      }
    ]
  }
}