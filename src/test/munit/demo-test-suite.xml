<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="demo-test-suite.xml" />
	<munit:test name="demo-test-suiteTest" doc:id="673e2e1d-b469-43b0-a923-c08068f992a6" >
		<munit:behavior >
			<munit-tools:mock-when doc:name="apikit:router" doc:id="ab166edc-3093-406b-b480-2483148aa0c2" processor="apikit:router">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="demo-api-config" attributeName="config-ref" />
				</munit-tools:with-attributes>
				<munit-tools:then-call flow="get:\health-check:demo-api-config" />
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<flow-ref doc:name="demo-api-main" doc:id="64d7006a-7017-4db3-bbd3-d8e0cb5cdfff" name="demo-api-main"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-equals doc:name="status: online" doc:id="e4c712c0-98da-47d7-bd9d-8870d1d01a5b" actual="#[payload]" expected='#[{"status": "Online"}]'/>
		</munit:validation>
	</munit:test>

</mule>
